# Porta interna do app (o Nginx encaminha /crm para cá)
PORT=3100
HOST=127.0.0.1

# Caminho onde o painel fica no domínio (https://odingdong.tech/crm)
BASE_PATH=/crm
# Endereço público completo, usado no código que você cola nos sites
PUBLIC_URL=https://odingdong.tech/crm

# Chaves das IAs — preencha uma ou as duas. Também dá para cadastrar/trocar
# pelo painel (Configurações), sem reiniciar o app.
# Claude: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Gemini: aistudio.google.com > Get API key
GEMINI_API_KEY=

# WhatsApp (Evolution API) onde ficam as instâncias. Cada empresa só informa a
# Session ID e a API Key da instância dela. Vazio = https://api.evolutiondingdong.online
# (também dá para trocar no painel: Configurações do sistema)
EVOLUTION_API_URL=
# Chave GLOBAL da Evolution (AUTHENTICATION_API_KEY do servidor — a mesma do
# DingDong Tracking). Com ela o CRM cria a conexão de cada empresa sozinho:
# o cliente só clica em "Gerar QR code". Também dá para colar no painel.
EVOLUTION_API_KEY=
# Quanto esperar (ms) o cliente parar de digitar antes de a IA responder no WhatsApp
WHATSAPP_ESPERA_MS=6000

# Primeiro administrador — criado só na primeira vez que o app sobe.
# Depois disso, troque a senha pelo próprio painel (Minha conta).
ADMIN_EMAIL=voce@exemplo.com
ADMIN_SENHA=troque-esta-senha

# Deixe true em produção (HTTPS). Use false só para testar em http://localhost
COOKIE_SECURE=true

# ---- Cadastro de novas contas (página "Criar conta") ----
# E-mails do sistema (código de confirmação, esqueci a senha, conta liberada)
# pelo Resend: crie a conta em resend.com, verifique o domínio odingdong.tech
# (registros DNS que o Resend mostra) e crie uma API Key.
# Sem esta chave, "Criar conta" e "Esqueci a senha" ficam escondidos.
RESEND_API_KEY=
# Remetente (o domínio precisa estar verificado no Resend)
EMAIL_REMETENTE=DingDong CRM <nao-responda@odingdong.tech>
# false = fecha o cadastro de contas novas (o login continua normal)
CADASTRO_ABERTO=true
# Aparecem nos Termos de Uso e na Política de Privacidade (/crm/termos e /crm/privacidade)
# Ex.: "Seu Nome" ou "Sua Empresa LTDA, CNPJ 00.000.000/0001-00"
RESPONSAVEL_LEGAL=
EMAIL_CONTATO=
